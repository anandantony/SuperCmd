{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "outDir": "./dist/main",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@platform": ["src/platform/mac/index.ts"],
      "@platform/*": ["src/platform/*"]
    }
  },
  "include": ["src/main/**/*"]
}



